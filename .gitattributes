# Normalise line endings so diffs stay readable across contributors' platforms.
* text=auto eol=lf

# Windows-only tooling keeps CRLF in the working tree
*.ps1   text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# LightBurn writes these; keep them stable and diffable
*.lbdev text eol=lf

# Never touched by normalisation
*.png   binary
*.jpg   binary
*.gif   binary
*.pcap  binary
*.pcapng binary
